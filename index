<!DOCTYPE html>
<html lang="az">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>DentalCare Clinic</title>
  <meta name="description" content="Müasir stomatoloji klinika üçün premium landing page." />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root{
      --primary:#0ea5a4;
      --primary-dark:#087b7b;
      --dark:#082f49;
      --text:#334155;
      --muted:#64748b;
      --soft:#ecfeff;
      --white:#ffffff;
      --line:#e2e8f0;
      --shadow:0 22px 60px rgba(15, 23, 42, .12);
      --radius:28px;
    }
    *{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{font-family:Inter,Arial,sans-serif;color:var(--text);background:#f8fafc;line-height:1.6;overflow-x:hidden}
    a{text-decoration:none;color:inherit}
    img{max-width:100%;display:block}
    .container{width:min(1180px,92%);margin:auto}
    .topbar{background:var(--dark);color:#dff; font-size:14px}
    .topbar .container{display:flex;justify-content:space-between;gap:18px;padding:10px 0;flex-wrap:wrap}
    header{position:sticky;top:0;z-index:20;background:rgba(255,255,255,.9);backdrop-filter:blur(14px);border-bottom:1px solid rgba(226,232,240,.8)}
    .nav{display:flex;align-items:center;justify-content:space-between;padding:16px 0;gap:20px}
    .logo{display:flex;align-items:center;gap:10px;font-weight:800;font-size:22px;color:var(--dark)}
    .logo-mark{width:42px;height:42px;border-radius:14px;background:linear-gradient(135deg,var(--primary),#38bdf8);display:grid;place-items:center;color:white;font-weight:900;box-shadow:0 12px 30px rgba(14,165,164,.35)}
    .menu{display:flex;align-items:center;gap:28px;font-weight:600;color:#475569}
    .menu a:hover{color:var(--primary-dark)}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:var(--primary);color:white;padding:14px 22px;border-radius:999px;font-weight:700;border:0;box-shadow:0 14px 30px rgba(14,165,164,.28);transition:.25s;cursor:pointer}
    .btn:hover{transform:translateY(-2px);background:var(--primary-dark)}
    .btn.secondary{background:white;color:var(--primary-dark);border:1px solid var(--line);box-shadow:none}
    .hero{position:relative;padding:86px 0 70px;background:radial-gradient(circle at 70% 10%,#ccfbf1 0,#f8fafc 38%,#fff 100%);overflow:hidden}
    .hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:54px;align-items:center}
    .badge{display:inline-flex;align-items:center;gap:8px;background:#e0fdfa;color:#0f766e;border:1px solid #99f6e4;border-radius:999px;padding:8px 14px;font-weight:700;font-size:14px;margin-bottom:22px}
    h1{font-size:clamp(42px,5vw,72px);line-height:1.03;color:var(--dark);letter-spacing:-2.3px;margin-bottom:22px}
    h1 span{color:var(--primary)}
    .lead{font-size:19px;color:#475569;max-width:600px;margin-bottom:28px}
    .hero-actions{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:34px}
    .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;max-width:620px}
    .stat{background:white;border:1px solid var(--line);border-radius:22px;padding:18px;box-shadow:0 12px 36px rgba(15,23,42,.06)}
    .stat b{display:block;color:var(--dark);font-size:28px;line-height:1}.stat span{color:var(--muted);font-size:13px;font-weight:600}
    .hero-card{position:relative;background:white;border-radius:36px;padding:18px;box-shadow:var(--shadow);border:1px solid var(--line)}
    .doctor-img{height:520px;border-radius:28px;background:linear-gradient(150deg,#dff9ff,#fff 48%,#ccfbf1);position:relative;overflow:hidden;display:flex;align-items:flex-end;justify-content:center}
    .doctor-img:before{content:"";position:absolute;width:310px;height:310px;border-radius:50%;background:#99f6e4;top:70px;right:40px;opacity:.65}
    .doctor{position:relative;width:78%;height:88%;border-radius:48% 48% 0 0;background:linear-gradient(#f8fafc,#e2e8f0);box-shadow:inset 0 0 0 12px white}
    .doctor:before{content:"";position:absolute;left:50%;top:58px;transform:translateX(-50%);width:130px;height:130px;border-radius:50%;background:#f7d6c8;box-shadow:0 -52px 0 -12px #1e293b}
    .doctor:after{content:"";position:absolute;left:50%;top:210px;transform:translateX(-50%);width:245px;height:260px;border-radius:60px 60px 0 0;background:white;border:1px solid #e2e8f0}
    .float{position:absolute;background:white;border:1px solid var(--line);border-radius:22px;padding:14px 16px;box-shadow:0 18px 45px rgba(15,23,42,.12);font-weight:700;color:var(--dark)}
    .float.one{left:-24px;top:70px}.float.two{right:-22px;bottom:72px}.float small{display:block;color:var(--muted);font-weight:600;font-size:12px}
    section{padding:80px 0}.section-head{text-align:center;max-width:760px;margin:0 auto 42px}.section-head h2{font-size:clamp(32px,4vw,48px);color:var(--dark);letter-spacing:-1.4px;line-height:1.1;margin-bottom:14px}.section-head p{color:var(--muted);font-size:17px}
    .services{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.service{background:white;border:1px solid var(--line);border-radius:var(--radius);padding:28px;box-shadow:0 14px 38px rgba(15,23,42,.05);transition:.25s}.service:hover{transform:translateY(-6px);box-shadow:var(--shadow)}.icon{width:58px;height:58px;border-radius:19px;background:#e0fdfa;color:#0f766e;display:grid;place-items:center;font-size:27px;margin-bottom:20px}.service h3{color:var(--dark);font-size:22px;margin-bottom:10px}.service p{color:var(--muted)}
    .about{background:white}.about-grid{display:grid;grid-template-columns:.95fr 1.05fr;gap:54px;align-items:center}.photo-block{height:520px;border-radius:38px;background:linear-gradient(135deg,#0f766e,#38bdf8);position:relative;overflow:hidden;box-shadow:var(--shadow)}.photo-block:before{content:"";position:absolute;inset:28px;border-radius:30px;border:2px solid rgba(255,255,255,.35)}.photo-block:after{content:"Müasir texnologiya • Steril mühit • Peşəkar komanda";position:absolute;left:36px;right:36px;bottom:36px;color:white;font-size:36px;line-height:1.12;font-weight:800;letter-spacing:-1px}.checklist{display:grid;gap:16px;margin-top:24px}.check{display:flex;gap:12px;align-items:flex-start;background:#f8fafc;border:1px solid var(--line);padding:16px;border-radius:20px}.check b{color:var(--dark)}.tick{width:26px;height:26px;border-radius:50%;background:#14b8a6;color:white;display:grid;place-items:center;flex:0 0 auto;font-weight:900}
    .process{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.step{background:white;border:1px solid var(--line);border-radius:26px;padding:24px}.step .num{width:44px;height:44px;border-radius:50%;background:var(--dark);color:white;display:grid;place-items:center;font-weight:800;margin-bottom:18px}.step h3{color:var(--dark);font-size:19px;margin-bottom:8px}.step p{color:var(--muted);font-size:14px}
    .doctors{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.doctor-card{background:white;border:1px solid var(--line);border-radius:28px;overflow:hidden;box-shadow:0 14px 38px rgba(15,23,42,.05)}.avatar{height:240px;background:linear-gradient(135deg,#e0fdfa,#f1f5f9);display:grid;place-items:center;font-size:82px}.doctor-card .info{padding:22px}.doctor-card h3{color:var(--dark)}.doctor-card p{color:var(--muted);font-size:14px;margin-top:4px}
    .pricing{background:linear-gradient(135deg,#083344,#0f766e);color:white}.pricing .section-head h2,.pricing .section-head p{color:white}.packages{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.package{background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);border-radius:30px;padding:30px;backdrop-filter:blur(10px)}.package.featured{background:white;color:var(--text);transform:scale(1.03)}.package h3{font-size:24px;margin-bottom:10px;color:inherit}.price{font-size:42px;font-weight:800;margin:18px 0}.package ul{list-style:none;display:grid;gap:10px;margin-bottom:24px}.package li:before{content:"✓";margin-right:8px;color:#14b8a6;font-weight:900}
    .testimonials{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.quote{background:white;border:1px solid var(--line);border-radius:28px;padding:28px;box-shadow:0 14px 38px rgba(15,23,42,.05)}.stars{color:#f59e0b;margin-bottom:14px}.quote p{color:#475569}.quote b{display:block;color:var(--dark);margin-top:18px}
    .contact{background:white}.contact-grid{display:grid;grid-template-columns:.95fr 1.05fr;gap:34px}.contact-card,.form{background:#f8fafc;border:1px solid var(--line);border-radius:30px;padding:30px}.contact-item{padding:18px 0;border-bottom:1px solid var(--line)}.contact-item:last-child{border-bottom:0}.contact-item b{display:block;color:var(--dark)}.form form{display:grid;gap:14px}input,textarea,select{width:100%;padding:16px 18px;border:1px solid var(--line);border-radius:16px;font:inherit;background:white;outline:none}textarea{min-height:126px;resize:vertical}input:focus,textarea:focus,select:focus{border-color:var(--primary);box-shadow:0 0 0 4px rgba(20,184,166,.12)}
    footer{background:#020617;color:#cbd5e1;padding:36px 0}footer .container{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}.social{display:flex;gap:10px}.social a{width:38px;height:38px;border-radius:50%;background:#0f172a;display:grid;place-items:center}
    .mobile-menu{display:none}
    @media(max-width:900px){.menu{display:none}.mobile-menu{display:block}.hero-grid,.about-grid,.contact-grid{grid-template-columns:1fr}.services,.doctors,.packages,.testimonials{grid-template-columns:1fr 1fr}.process{grid-template-columns:1fr 1fr}.doctor-img{height:430px}.float{display:none}.stats{grid-template-columns:1fr 1fr 1fr}}
    @media(max-width:620px){.topbar .container{font-size:12px}.hero{padding:52px 0}.services,.doctors,.packages,.testimonials,.process,.stats{grid-template-columns:1fr}.hero-actions .btn{width:100%}.photo-block{height:420px}.photo-block:after{font-size:28px}section{padding:58px 0}.package.featured{transform:none}}
  </style>
</head>
<body>
  <div class="topbar">
